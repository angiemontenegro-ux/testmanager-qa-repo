67.0 APEX_CODE,DEBUG;APEX_PROFILING,INFO
Execute Anonymous: // SH-1174 / TC-70 escenario idx 5: un Inventory Adjustment posterior NO debe corromper el
Execute Anonymous: // promedio landed. Brecha de cobertura real: CERO referencias a Inventory Adjustment en los
Execute Anonymous: // 17 archivos de la PR #2585 (ni en codigo de produccion ni en tests).
Execute Anonymous: //
Execute Anonymous: // Recepcion: 10 u @ $10.00 + $20.00 de gasto -> efectivo $12.00/u -> promedio $12.00, stock 10.
Execute Anonymous: // Luego un Inventory Adjustment de tipo 'Adjustment' da de baja 3 unidades (merma).
Execute Anonymous: // CONVENCION DE SIGNO (verificada en la formula de CatalogItem.Total_Stock__c:
Execute Anonymous: //   Number_of_Items_Ordered - Number_of_Items_Bought - Number_of_Items_Adjusted + ...):
Execute Anonymous: //   Number_of_Items_Adjusted__c se RESTA, asi que una Quantity__c POSITIVA = unidades dadas de baja.
Execute Anonymous: // Esperado: el stock baja a 7, PERO el promedio landed sigue en $12.00 y el ICH de la recepcion
Execute Anonymous: // conserva su desglose (Unit_Cost 10.00 / Allocated_Expense 20.00 / Effective_Cost 12.00).
Execute Anonymous: 
Execute Anonymous: String tag = 'QA-1174-S5-' + String.valueOf(Datetime.now().getTime());
Execute Anonymous: 
Execute Anonymous: List<Auctifera__POS_Settings__c> settings = [SELECT Id, Auctifera__Use_Weighted_Cost_Item_Calculation__c FROM Auctifera__POS_Settings__c LIMIT 1];
Execute Anonymous: if (settings.isEmpty()) {
Execute Anonymous:     insert new Auctifera__POS_Settings__c(Auctifera__Use_Weighted_Cost_Item_Calculation__c = true);
Execute Anonymous: } else if (settings[0].Auctifera__Use_Weighted_Cost_Item_Calculation__c != true) {
Execute Anonymous:     settings[0].Auctifera__Use_Weighted_Cost_Item_Calculation__c = true;
Execute Anonymous:     update settings[0];
Execute Anonymous: }
Execute Anonymous: 
Execute Anonymous: Auctifera__CatalogItem__c shopItem = new Auctifera__CatalogItem__c(
Execute Anonymous:     Name = tag + ' Mug',
Execute Anonymous:     Auctifera__Product_ID__c = tag,
Execute Anonymous:     Auctifera__Price__c = 25
Execute Anonymous: );
Execute Anonymous: insert shopItem;
Execute Anonymous: 
Execute Anonymous: Auctifera__Purchase_Order__c po = new Auctifera__Purchase_Order__c(Name = tag + ' PO');
Execute Anonymous: insert po;
Execute Anonymous: insert new Auctifera__Purchase_Order_Expense__c(
Execute Anonymous:     Name = 'Freight',
Execute Anonymous:     Auctifera__Purchase_Order__c = po.Id,
Execute Anonymous:     Auctifera__Calculation_Type__c = 'Amount',
Execute Anonymous:     Auctifera__Amount__c = 20
Execute Anonymous: );
Execute Anonymous: Auctifera__StockReplenishmentOrder__c line = new Auctifera__StockReplenishmentOrder__c(
Execute Anonymous:     Auctifera__Catalog_Item__c = shopItem.Id,
Execute Anonymous:     Auctifera__Purchase_Order__c = po.Id,
Execute Anonymous:     Auctifera__Order_Amount__c = 10,
Execute Anonymous:     Auctifera__Order_Date__c = Date.newInstance(2026, 1, 1),
Execute Anonymous:     Auctifera__Order_Status__c = 'Draft',
Execute Anonymous:     Auctifera__Item_Cost__c = 10
Execute Anonymous: );
Execute Anonymous: insert line;
Execute Anonymous: line.Auctifera__Order_Status__c = 'Received - Complete';
Execute Anonymous: update line;
Execute Anonymous: 
Execute Anonymous: Auctifera__CatalogItem__c beforeAdj = [SELECT Auctifera__Current_Item_Cost__c, Auctifera__Total_Stock__c FROM Auctifera__CatalogItem__c WHERE Id = :shopItem.Id];
Execute Anonymous: List<Auctifera__Item_Cost_History__c> ichBefore = [
Execute Anonymous:     SELECT Auctifera__Cost__c, Auctifera__Stock__c, Auctifera__Unit_Cost__c,
Execute Anonymous:            Auctifera__Allocated_Expense__c, Auctifera__Effective_Cost__c
Execute Anonymous:     FROM Auctifera__Item_Cost_History__c
Execute Anonymous:     WHERE Auctifera__Shop_Item__c = :shopItem.Id
Execute Anonymous:     ORDER BY Auctifera__Effective_At__c ASC, CreatedDate ASC
Execute Anonymous: ];
Execute Anonymous: System.debug('=== SH-1174 S5 :: ANTES DEL AJUSTE ===');
Execute Anonymous: System.debug('Current_Item_Cost__c = ' + beforeAdj.Auctifera__Current_Item_Cost__c + ' (esperado 12.00)');
Execute Anonymous: System.debug('Total_Stock__c       = ' + beforeAdj.Auctifera__Total_Stock__c + ' (esperado 10)');
Execute Anonymous: for (Auctifera__Item_Cost_History__c ich : ichBefore) {
Execute Anonymous:     System.debug('ICH cost=' + ich.Auctifera__Cost__c + ' stock=' + ich.Auctifera__Stock__c +
Execute Anonymous:         ' unitCost=' + ich.Auctifera__Unit_Cost__c + ' allocExpense=' + ich.Auctifera__Allocated_Expense__c +
Execute Anonymous:         ' effectiveCost=' + ich.Auctifera__Effective_Cost__c);
Execute Anonymous: }
Execute Anonymous: 
Execute Anonymous: // ---------- INVENTORY ADJUSTMENT: merma de 3 unidades ----------
Execute Anonymous: Auctifera__Inventory_Adjustment__c adjustment = new Auctifera__Inventory_Adjustment__c(
Execute Anonymous:     Auctifera__Shop_Item__c = shopItem.Id,
Execute Anonymous:     Auctifera__Quantity__c = 3,
Execute Anonymous:     Auctifera__Type__c = 'Adjustment',
Execute Anonymous:     Auctifera__Adjustment_Reason__c = 'Damaged/Broken',
Execute Anonymous:     Auctifera__Adjustment_Date__c = Date.newInstance(2026, 3, 1)
Execute Anonymous: );
Execute Anonymous: insert adjustment;
Execute Anonymous: 
Execute Anonymous: Auctifera__CatalogItem__c afterAdj = [SELECT Auctifera__Current_Item_Cost__c, Auctifera__Total_Stock__c FROM Auctifera__CatalogItem__c WHERE Id = :shopItem.Id];
Execute Anonymous: List<Auctifera__Item_Cost_History__c> ichAfter = [
Execute Anonymous:     SELECT Auctifera__Cost__c, Auctifera__Previous_Cost__c, Auctifera__Stock__c, Auctifera__Previous_Stock__c,
Execute Anonymous:            Auctifera__Unit_Cost__c, Auctifera__Allocated_Expense__c, Auctifera__Effective_Cost__c
Execute Anonymous:     FROM Auctifera__Item_Cost_History__c
Execute Anonymous:     WHERE Auctifera__Shop_Item__c = :shopItem.Id
Execute Anonymous:     ORDER BY Auctifera__Effective_At__c ASC, CreatedDate ASC
Execute Anonymous: ];
Execute Anonymous: Auctifera__Inventory_Adjustment__c adjAfter = [
Execute Anonymous:     SELECT Auctifera__Quantity__c, Auctifera__Snapshot_Item_Cost__c, Item_Cost_History__c, Auctifera__Merchandise_Cost__c
Execute Anonymous:     FROM Auctifera__Inventory_Adjustment__c WHERE Id = :adjustment.Id
Execute Anonymous: ];
Execute Anonymous: 
Execute Anonymous: System.debug('=== SH-1174 S5 :: DESPUES DEL AJUSTE ===');
Execute Anonymous: System.debug('Current_Item_Cost__c = ' + afterAdj.Auctifera__Current_Item_Cost__c + ' (esperado 12.00, SIN cambio)');
Execute Anonymous: System.debug('Total_Stock__c       = ' + afterAdj.Auctifera__Total_Stock__c + ' (esperado 7)');
Execute Anonymous: System.debug('Ajuste: qty=' + adjAfter.Auctifera__Quantity__c + ' snapshotCost=' + adjAfter.Auctifera__Snapshot_Item_Cost__c +
Execute Anonymous:     ' ICH=' + adjAfter.Item_Cost_History__c + ' merchandiseCost=' + adjAfter.Auctifera__Merchandise_Cost__c);
Execute Anonymous: System.debug('=== CADENA ICH DESPUES (' + ichAfter.size() + ') ===');
Execute Anonymous: for (Auctifera__Item_Cost_History__c ich : ichAfter) {
Execute Anonymous:     System.debug('ICH prevCost=' + ich.Auctifera__Previous_Cost__c + ' cost=' + ich.Auctifera__Cost__c +
Execute Anonymous:         ' prevStock=' + ich.Auctifera__Previous_Stock__c + ' stock=' + ich.Auctifera__Stock__c +
Execute Anonymous:         ' unitCost=' + ich.Auctifera__Unit_Cost__c + ' allocExpense=' + ich.Auctifera__Allocated_Expense__c +
Execute Anonymous:         ' effectiveCost=' + ich.Auctifera__Effective_Cost__c);
Execute Anonymous: }
Execute Anonymous: 
Execute Anonymous: Boolean costIntact = afterAdj.Auctifera__Current_Item_Cost__c == 12.00;
Execute Anonymous: Boolean breakdownIntact = !ichAfter.isEmpty() && ichAfter[0].Auctifera__Allocated_Expense__c == 20 && ichAfter[0].Auctifera__Effective_Cost__c == 12;
Execute Anonymous: System.debug('=== VEREDICTO S5: promedio intacto=' + costIntact + ' | desglose intacto=' + breakdownIntact + ' ===');
Execute Anonymous: System.debug('Shop Item Id: ' + shopItem.Id);

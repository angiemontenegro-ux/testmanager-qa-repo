67.0 APEX_CODE,DEBUG;APEX_PROFILING,INFO
Execute Anonymous: // SH-1174 / TR-037 regresion tecnica T2 (HALLAZGO-1): al editar el costo de una linea YA RECIBIDA,
Execute Anonymous: // el ICH pierde el gasto asignado y vuelve a base de costo CRUDO. El gasto de la PO queda sin
Execute Anonymous: // asignar en esa linea hasta que Total_Expenses__c cambie otra vez.
Execute Anonymous: //
Execute Anonymous: // Montaje: PO con $100 de flete, dos lineas de 10 u @ $10 = $100 c/u (valor total $200).
Execute Anonymous: //   Prorrateo -> $50 por linea -> $5/u -> costo efectivo $15/u. Promedio tras ambas recepciones: $15.00.
Execute Anonymous: // Accion: se edita Item_Cost__c de la linea A de $10 a $20 (correccion post-recepcion).
Execute Anonymous: // Esperado por AC-1/AC-2 (prorrateo por valor + promedio sobre costo landed):
Execute Anonymous: //   nuevos valores A=$200, B=$100 -> $100 de flete reparte A $66.67 ($6.667/u -> efectivo $26.667)
Execute Anonymous: //   y B $33.33 ($3.333/u -> efectivo $13.333) -> promedio final $20.00.
Execute Anonymous: // Observado con la PR: ver salida.
Execute Anonymous: 
Execute Anonymous: String tag = 'QA-1174-T2-' + String.valueOf(Datetime.now().getTime());
Execute Anonymous: 
Execute Anonymous: List<Auctifera__POS_Settings__c> settings = [SELECT Id, Auctifera__Use_Weighted_Cost_Item_Calculation__c FROM Auctifera__POS_Settings__c LIMIT 1];
Execute Anonymous: if (settings.isEmpty()) {
Execute Anonymous:     insert new Auctifera__POS_Settings__c(Auctifera__Use_Weighted_Cost_Item_Calculation__c = true);
Execute Anonymous: }
Execute Anonymous: 
Execute Anonymous: Auctifera__CatalogItem__c shopItem = new Auctifera__CatalogItem__c(
Execute Anonymous:     Name = tag + ' Item', Auctifera__Product_ID__c = tag, Auctifera__Price__c = 40);
Execute Anonymous: insert shopItem;
Execute Anonymous: 
Execute Anonymous: Auctifera__Purchase_Order__c po = new Auctifera__Purchase_Order__c(Name = tag + ' PO');
Execute Anonymous: insert po;
Execute Anonymous: insert new Auctifera__Purchase_Order_Expense__c(
Execute Anonymous:     Name = 'Freight', Auctifera__Purchase_Order__c = po.Id,
Execute Anonymous:     Auctifera__Calculation_Type__c = 'Amount', Auctifera__Amount__c = 100);
Execute Anonymous: 
Execute Anonymous: Auctifera__StockReplenishmentOrder__c lineA = new Auctifera__StockReplenishmentOrder__c(
Execute Anonymous:     Auctifera__Catalog_Item__c = shopItem.Id, Auctifera__Purchase_Order__c = po.Id,
Execute Anonymous:     Auctifera__Order_Amount__c = 10, Auctifera__Order_Date__c = Date.newInstance(2026, 1, 1),
Execute Anonymous:     Auctifera__Order_Status__c = 'Draft', Auctifera__Item_Cost__c = 10);
Execute Anonymous: Auctifera__StockReplenishmentOrder__c lineB = new Auctifera__StockReplenishmentOrder__c(
Execute Anonymous:     Auctifera__Catalog_Item__c = shopItem.Id, Auctifera__Purchase_Order__c = po.Id,
Execute Anonymous:     Auctifera__Order_Amount__c = 10, Auctifera__Order_Date__c = Date.newInstance(2026, 1, 2),
Execute Anonymous:     Auctifera__Order_Status__c = 'Draft', Auctifera__Item_Cost__c = 10);
Execute Anonymous: insert new List<Auctifera__StockReplenishmentOrder__c>{ lineA, lineB };
Execute Anonymous: 
Execute Anonymous: lineA.Auctifera__Order_Status__c = 'Received - Complete'; update lineA;
Execute Anonymous: lineB.Auctifera__Order_Status__c = 'Received - Complete'; update lineB;
Execute Anonymous: 
Execute Anonymous: Auctifera__CatalogItem__c before = [SELECT Auctifera__Current_Item_Cost__c FROM Auctifera__CatalogItem__c WHERE Id = :shopItem.Id];
Execute Anonymous: System.debug('=== T2 :: ANTES DE LA EDICION ===');
Execute Anonymous: System.debug('Current_Item_Cost__c = ' + before.Auctifera__Current_Item_Cost__c + ' (esperado 15.00)');
Execute Anonymous: for (Auctifera__Item_Cost_History__c ich : [
Execute Anonymous:         SELECT Auctifera__Cost__c, Auctifera__Unit_Cost__c, Auctifera__Allocated_Expense__c, Auctifera__Effective_Cost__c,
Execute Anonymous:                Auctifera__Stock_Replenishment_Order__c
Execute Anonymous:         FROM Auctifera__Item_Cost_History__c WHERE Auctifera__Shop_Item__c = :shopItem.Id
Execute Anonymous:         ORDER BY Auctifera__Effective_At__c ASC, CreatedDate ASC]) {
Execute Anonymous:     System.debug((ich.Auctifera__Stock_Replenishment_Order__c == lineA.Id ? 'LINEA A' : 'LINEA B') +
Execute Anonymous:         ' cost=' + ich.Auctifera__Cost__c + ' unitCost=' + ich.Auctifera__Unit_Cost__c +
Execute Anonymous:         ' allocExpense=' + ich.Auctifera__Allocated_Expense__c + ' effectiveCost=' + ich.Auctifera__Effective_Cost__c);
Execute Anonymous: }
Execute Anonymous: 
Execute Anonymous: // ACCION: correccion del costo de la linea A despues de recibida
Execute Anonymous: lineA.Auctifera__Item_Cost__c = 20;
Execute Anonymous: update lineA;
Execute Anonymous: 
Execute Anonymous: Auctifera__CatalogItem__c after = [SELECT Auctifera__Current_Item_Cost__c FROM Auctifera__CatalogItem__c WHERE Id = :shopItem.Id];
Execute Anonymous: Decimal expenseStillAllocated = 0;
Execute Anonymous: System.debug('=== T2 :: DESPUES DE EDITAR Item_Cost__c DE LA LINEA A A $20 ===');
Execute Anonymous: System.debug('Current_Item_Cost__c = ' + after.Auctifera__Current_Item_Cost__c + ' (esperado por AC-2: 20.00)');
Execute Anonymous: for (Auctifera__Item_Cost_History__c ich : [
Execute Anonymous:         SELECT Auctifera__Cost__c, Auctifera__Unit_Cost__c, Auctifera__Allocated_Expense__c, Auctifera__Effective_Cost__c,
Execute Anonymous:                Auctifera__Stock_Replenishment_Order__c
Execute Anonymous:         FROM Auctifera__Item_Cost_History__c WHERE Auctifera__Shop_Item__c = :shopItem.Id
Execute Anonymous:         ORDER BY Auctifera__Effective_At__c ASC, CreatedDate ASC]) {
Execute Anonymous:     System.debug((ich.Auctifera__Stock_Replenishment_Order__c == lineA.Id ? 'LINEA A' : 'LINEA B') +
Execute Anonymous:         ' cost=' + ich.Auctifera__Cost__c + ' unitCost=' + ich.Auctifera__Unit_Cost__c +
Execute Anonymous:         ' allocExpense=' + ich.Auctifera__Allocated_Expense__c + ' effectiveCost=' + ich.Auctifera__Effective_Cost__c);
Execute Anonymous:     expenseStillAllocated += (ich.Auctifera__Allocated_Expense__c == null ? 0 : ich.Auctifera__Allocated_Expense__c);
Execute Anonymous: }
Execute Anonymous: Auctifera__Purchase_Order__c poAfter = [SELECT Auctifera__Total_Expenses__c FROM Auctifera__Purchase_Order__c WHERE Id = :po.Id];
Execute Anonymous: System.debug('Total_Expenses__c de la PO = ' + poAfter.Auctifera__Total_Expenses__c);
Execute Anonymous: System.debug('Gasto TODAVIA asignado en la cadena de ICH = ' + expenseStillAllocated);
Execute Anonymous: System.debug('Gasto HUERFANO (en la PO pero no asignado) = ' + (poAfter.Auctifera__Total_Expenses__c - expenseStillAllocated));
Execute Anonymous: System.debug('Shop Item Id: ' + shopItem.Id);

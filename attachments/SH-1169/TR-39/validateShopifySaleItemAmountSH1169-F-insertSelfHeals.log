67.0 APEX_CODE,DEBUG;APEX_PROFILING,INFO
Execute Anonymous: /*
Execute Anonymous:  * SH-1169 / PR #2569 — Scenario 6 (TC-67): a bypassed Shopify INSERT self-heals via the same-transaction
Execute Anonymous:  * Client Purchase cascade (documented nuance — this is why the main reproduction is modeled as an
Execute Anonymous:  * UPDATE, not an insert).
Execute Anonymous:  * Run standalone (own transaction / own SOQL budget).
Execute Anonymous:  *
Execute Anonymous:  *     sf apex run -o <ORG_ALIAS> -f scripts/apex/validateShopifySaleItemAmountSH1169-F-insertSelfHeals.apex
Execute Anonymous:  *
Execute Anonymous:  * What this proves: inserting a Sale_Item__c directly with Technical_Bypass_Triggers__c = true and the
Execute Anonymous:  * wrong Amount__c already set still ends up with the correct Amount__c after the insert, because a
Execute Anonymous:  * same-transaction Client Purchase recalculation re-saves the child unflagged (the one-shot bypass mark
Execute Anonymous:  * only covers the flagged write itself, not later cascades in the same transaction).
Execute Anonymous:  * All DML is rolled back at the end — the org is left exactly as it was found.
Execute Anonymous:  */
Execute Anonymous: 
Execute Anonymous: final String ns = Schema.getGlobalDescribe().containsKey('Auctifera__CatalogItem__c') ? 'Auctifera__' : '';
Execute Anonymous: final Schema.SObjectType ciType = Schema.getGlobalDescribe().get(ns + 'CatalogItem__c');
Execute Anonymous: final Schema.SObjectType cpType = Schema.getGlobalDescribe().get(ns + 'ClientPurchase__c');
Execute Anonymous: final Schema.SObjectType siType = Schema.getGlobalDescribe().get(ns + 'Sale_Item__c');
Execute Anonymous: 
Execute Anonymous: System.Savepoint sp = Database.setSavepoint();
Execute Anonymous: Boolean pass = false;
Execute Anonymous: Decimal amount;
Execute Anonymous: String errorMsg;
Execute Anonymous: try {
Execute Anonymous:     SObject item = ciType.newSObject();
Execute Anonymous:     item.put('Name', 'SH-1169 Validation Item F');
Execute Anonymous:     item.put(ns + 'Price__c', 10);
Execute Anonymous:     item.put(ns + 'Tax__c', 0);
Execute Anonymous:     item.put(ns + 'Tax_Model__c', 'Tax not included in the price');
Execute Anonymous:     item.put(ns + 'Product_ID__c', 'SH1169-F-' + String.valueOf(Datetime.now().getTime()));
Execute Anonymous:     item.put(ns + 'Bypass_Stock__c', true);
Execute Anonymous:     insert item;
Execute Anonymous: 
Execute Anonymous:     SObject purchase = cpType.newSObject();
Execute Anonymous:     insert purchase;
Execute Anonymous: 
Execute Anonymous:     // Single INSERT with the bypass flag and wrong Amount already set — unlike scenarios A/C/D, there
Execute Anonymous:     // is no separate insert-then-update: this is the insert path itself.
Execute Anonymous:     SObject line = siType.newSObject();
Execute Anonymous:     line.put(ns + 'Catalog_Item__c', item.Id);
Execute Anonymous:     line.put(ns + 'Client_Purchase__c', purchase.Id);
Execute Anonymous:     line.put(ns + 'Item_Price__c', 40);
Execute Anonymous:     line.put(ns + 'Number_of_Items_bought__c', 3);
Execute Anonymous:     line.put(ns + 'Amount__c', 40); // wrong value coming from the external Shopify payload
Execute Anonymous:     line.put(ns + 'Price_Without_Tax__c', 40);
Execute Anonymous:     line.put(ns + 'Source__c', 'Shopify');
Execute Anonymous:     line.put(ns + 'Technical_Bypass_Triggers__c', true);
Execute Anonymous:     insert line;
Execute Anonymous: 
Execute Anonymous:     SObject stored = Database.query(
Execute Anonymous:         'SELECT ' + ns + 'Amount__c, ' + ns + 'Technical_Bypass_Triggers__c ' +
Execute Anonymous:         'FROM ' + ns + 'Sale_Item__c WHERE Id = \'' + line.Id + '\''
Execute Anonymous:     );
Execute Anonymous:     amount = (Decimal) stored.get(ns + 'Amount__c');
Execute Anonymous:     Boolean flagCleared = (stored.get(ns + 'Technical_Bypass_Triggers__c') == false);
Execute Anonymous:     pass = (amount == 120) && flagCleared;
Execute Anonymous: } catch (Exception e) {
Execute Anonymous:     errorMsg = e.getTypeName() + ': ' + e.getMessage() + ' (line ' + e.getLineNumber() + ')';
Execute Anonymous: } finally {
Execute Anonymous:     Database.rollback(sp);
Execute Anonymous: }
Execute Anonymous: 
Execute Anonymous: System.debug(LoggingLevel.INFO, '======================================================');
Execute Anonymous: System.debug(LoggingLevel.INFO, '  SCENARIO 6 (TC-67) - bypassed Shopify INSERT self-heals via cascade');
Execute Anonymous: if (errorMsg != null) {
Execute Anonymous:     System.debug(LoggingLevel.ERROR, '  EXCEPTION THROWN: ' + errorMsg);
Execute Anonymous:     System.debug(LoggingLevel.ERROR, '  RESULT: FAIL');
Execute Anonymous: } else {
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  Amount__c = ' + amount + ' (want 120, self-healed by the Client Purchase cascade)');
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  RESULT: ' + (pass ? 'PASS' : 'FAIL'));
Execute Anonymous: }
Execute Anonymous: System.debug(LoggingLevel.INFO, '======================================================');

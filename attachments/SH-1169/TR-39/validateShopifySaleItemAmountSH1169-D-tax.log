67.0 APEX_CODE,DEBUG;APEX_PROFILING,INFO
Execute Anonymous: /*
Execute Anonymous:  * SH-1169 / PR #2569 — Scenario D: Shopify bypassed update WITH tax, no discount.
Execute Anonymous:  * Run standalone (own transaction / own SOQL budget).
Execute Anonymous:  *
Execute Anonymous:  *     sf apex run -o <ORG_ALIAS> -f scripts/apex/validateShopifySaleItemAmountSH1169-D-tax.apex
Execute Anonymous:  *
Execute Anonymous:  * What this proves (César's review comment on PR #2569): the original fix assumed "Shopify taxes are
Execute Anonymous:  * handled at the Client Purchase level, not per Sale Item" and never added tax to Amount__c. If a
Execute Anonymous:  * Shopify Sale Item ever carries a non-zero item-level tax rate, the pre-review fix left Tax_Amount__c
Execute Anonymous:  * stale/untouched while Amount__c stayed at the gross price — an inconsistent triple. The post-review
Execute Anonymous:  * fix delegates to calculateAmount(), which adds tax on top of the (discount-adjusted) subtotal and
Execute Anonymous:  * keeps Tax_Amount__c consistent, regardless of whether the "no item-level tax" assumption holds.
Execute Anonymous:  *
Execute Anonymous:  * Catalog item has Tax__c = 10%. Gross = Price_Without_Tax__c = Item_Price__c(50) * Qty(2) = 100.
Execute Anonymous:  * Expected: Tax_Amount__c = 10 (10% of 100), Amount__c = 110 (subtotal + tax).
Execute Anonymous:  *
Execute Anonymous:  * Before the fix: Amount__c = 100, Tax_Amount__c stays at whatever the initial insert left it at
Execute Anonymous:  * (FAIL — tax silently ignored). After the fix: Amount__c = 110, Tax_Amount__c = 10 (PASS).
Execute Anonymous:  * All DML is rolled back at the end — the org is left exactly as it was found.
Execute Anonymous:  */
Execute Anonymous: 
Execute Anonymous: final String ns = Schema.getGlobalDescribe().containsKey('Auctifera__CatalogItem__c') ? 'Auctifera__' : '';
Execute Anonymous: final Schema.SObjectType ciType = Schema.getGlobalDescribe().get(ns + 'CatalogItem__c');
Execute Anonymous: final Schema.SObjectType cpType = Schema.getGlobalDescribe().get(ns + 'ClientPurchase__c');
Execute Anonymous: final Schema.SObjectType siType = Schema.getGlobalDescribe().get(ns + 'Sale_Item__c');
Execute Anonymous: 
Execute Anonymous: System.Savepoint sp = Database.setSavepoint();
Execute Anonymous: try {
Execute Anonymous:     SObject item = ciType.newSObject();
Execute Anonymous:     item.put('Name', 'SH-1169 Validation Item D');
Execute Anonymous:     item.put(ns + 'Price__c', 10);
Execute Anonymous:     item.put(ns + 'Tax__c', 10); // 10% tax, so this scenario isolates the tax signal
Execute Anonymous:     item.put(ns + 'Tax_Model__c', 'Tax not included in the price');
Execute Anonymous:     item.put(ns + 'Product_ID__c', 'SH1169-D-' + String.valueOf(Datetime.now().getTime()));
Execute Anonymous:     item.put(ns + 'Bypass_Stock__c', true);
Execute Anonymous:     insert item;
Execute Anonymous: 
Execute Anonymous:     SObject purchase = cpType.newSObject();
Execute Anonymous:     insert purchase;
Execute Anonymous: 
Execute Anonymous:     SObject line = siType.newSObject();
Execute Anonymous:     line.put(ns + 'Catalog_Item__c', item.Id);
Execute Anonymous:     line.put(ns + 'Client_Purchase__c', purchase.Id);
Execute Anonymous:     line.put(ns + 'Number_of_Items_bought__c', 2);
Execute Anonymous:     insert line;
Execute Anonymous: 
Execute Anonymous:     line.put(ns + 'Item_Price__c', 50);
Execute Anonymous:     line.put(ns + 'Number_of_Items_bought__c', 2);
Execute Anonymous:     line.put(ns + 'Amount__c', 50); // wrong value coming from the external Shopify payload
Execute Anonymous:     line.put(ns + 'Source__c', 'Shopify');
Execute Anonymous:     line.put(ns + 'Technical_Bypass_Triggers__c', true);
Execute Anonymous:     update line;
Execute Anonymous: 
Execute Anonymous:     SObject stored = Database.query(
Execute Anonymous:         'SELECT ' + ns + 'Amount__c, ' + ns + 'Price_Without_Tax__c, ' + ns + 'Tax_Amount__c ' +
Execute Anonymous:         'FROM ' + ns + 'Sale_Item__c WHERE Id = \'' + line.Id + '\''
Execute Anonymous:     );
Execute Anonymous:     Decimal amount = (Decimal) stored.get(ns + 'Amount__c');
Execute Anonymous:     Decimal priceWithoutTax = (Decimal) stored.get(ns + 'Price_Without_Tax__c');
Execute Anonymous:     Decimal taxAmount = (Decimal) stored.get(ns + 'Tax_Amount__c');
Execute Anonymous:     Boolean pass = (amount == 110) && (priceWithoutTax == 100) && (taxAmount == 10);
Execute Anonymous: 
Execute Anonymous:     System.debug(LoggingLevel.INFO, '======================================================');
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  SCENARIO D - Shopify bypassed WITH tax, no discount');
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  Price_Without_Tax__c = ' + priceWithoutTax + ' (want 100)');
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  Tax_Amount__c = ' + taxAmount + ' (want 10)');
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  Amount__c = ' + amount + ' (want 110, subtotal + tax)');
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  RESULT: ' + (pass ? 'PASS' : 'FAIL (tax ignored)'));
Execute Anonymous:     System.debug(LoggingLevel.INFO, '======================================================');
Execute Anonymous: } catch (Exception e) {
Execute Anonymous:     System.debug(LoggingLevel.ERROR, 'SETUP ERROR: ' + e.getTypeName() + ': ' + e.getMessage() + ' (line ' + e.getLineNumber() + ')');
Execute Anonymous: } finally {
Execute Anonymous:     Database.rollback(sp);
Execute Anonymous: }

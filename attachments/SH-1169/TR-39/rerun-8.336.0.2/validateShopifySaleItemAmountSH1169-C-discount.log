67.0 APEX_CODE,DEBUG;APEX_PROFILING,INFO
Execute Anonymous: /*
Execute Anonymous:  * SH-1169 / PR #2569 — Scenario C: Shopify bypassed update WITH a discount, no tax.
Execute Anonymous:  * Run standalone (own transaction / own SOQL budget).
Execute Anonymous:  *
Execute Anonymous:  *     sf apex run -o <ORG_ALIAS> -f scripts/apex/validateShopifySaleItemAmountSH1169-C-discount.apex
Execute Anonymous:  *
Execute Anonymous:  * What this proves (César's review comment on PR #2569): the pre-review fix computed
Execute Anonymous:  * Amount__c = Price_Without_Tax__c = Item_Price__c * Number_of_Items_bought__c — the GROSS price, one
Execute Anonymous:  * link before subtotal (minus discount) in the real chain. Any Shopify line with a discount got the
Execute Anonymous:  * wrong Amount__c (overstated). The post-review fix delegates to calculateAmount(), which subtracts the
Execute Anonymous:  * discount before computing Amount__c.
Execute Anonymous:  *
Execute Anonymous:  * Gross = Item_Price__c(40) * Qty(3) = 120. Discount = 20 (org validation requires discount amounts
Execute Anonymous:  * stored negative, hence -20). Expected: Subtotal_before_discount__c = 120 (gross, untouched by the
Execute Anonymous:  * discount), Amount__c = Price_Without_Tax__c = 100 (net of discount) since this item is tax-free.
Execute Anonymous:  *
Execute Anonymous:  * Before the fix: Amount__c = Price_Without_Tax__c = 120 (FAIL — discount silently ignored).
Execute Anonymous:  * After the fix: Amount__c = Price_Without_Tax__c = 100 (PASS).
Execute Anonymous:  * All DML is rolled back at the end — the org is left exactly as it was found.
Execute Anonymous:  */
Execute Anonymous: 
Execute Anonymous: final String ns = Schema.getGlobalDescribe().containsKey('Auctifera__CatalogItem__c') ? 'Auctifera__' : '';
Execute Anonymous: final Schema.SObjectType ciType = Schema.getGlobalDescribe().get(ns + 'CatalogItem__c');
Execute Anonymous: final Schema.SObjectType cpType = Schema.getGlobalDescribe().get(ns + 'ClientPurchase__c');
Execute Anonymous: final Schema.SObjectType siType = Schema.getGlobalDescribe().get(ns + 'Sale_Item__c');
Execute Anonymous: 
Execute Anonymous: System.Savepoint sp = Database.setSavepoint();
Execute Anonymous: try {
Execute Anonymous:     SObject item = ciType.newSObject();
Execute Anonymous:     item.put('Name', 'SH-1169 Validation Item C');
Execute Anonymous:     item.put(ns + 'Price__c', 10);
Execute Anonymous:     item.put(ns + 'Tax__c', 0); // tax-free, so this scenario isolates the discount signal
Execute Anonymous:     item.put(ns + 'Tax_Model__c', 'Tax not included in the price');
Execute Anonymous:     item.put(ns + 'Product_ID__c', 'SH1169-C-' + String.valueOf(Datetime.now().getTime()));
Execute Anonymous:     item.put(ns + 'Bypass_Stock__c', true);
Execute Anonymous:     insert item;
Execute Anonymous: 
Execute Anonymous:     SObject purchase = cpType.newSObject();
Execute Anonymous:     insert purchase;
Execute Anonymous: 
Execute Anonymous:     SObject line = siType.newSObject();
Execute Anonymous:     line.put(ns + 'Catalog_Item__c', item.Id);
Execute Anonymous:     line.put(ns + 'Client_Purchase__c', purchase.Id);
Execute Anonymous:     line.put(ns + 'Number_of_Items_bought__c', 2);
Execute Anonymous:     insert line;
Execute Anonymous: 
Execute Anonymous:     line.put(ns + 'Item_Price__c', 40);
Execute Anonymous:     line.put(ns + 'Number_of_Items_bought__c', 3);
Execute Anonymous:     line.put(ns + 'Amount__c', 40); // wrong value coming from the external Shopify payload
Execute Anonymous:     line.put(ns + 'Additional_Discount_Amount__c', -20); // org validation requires discounts stored negative
Execute Anonymous:     line.put(ns + 'Price_Without_Tax__c', 120); // wrong: equals gross, ignores the discount above
Execute Anonymous:     line.put(ns + 'Source__c', 'Shopify');
Execute Anonymous:     line.put(ns + 'Technical_Bypass_Triggers__c', true);
Execute Anonymous:     update line;
Execute Anonymous: 
Execute Anonymous:     SObject stored = Database.query(
Execute Anonymous:         'SELECT ' + ns + 'Amount__c, ' + ns + 'Price_Without_Tax__c, ' + ns + 'Subtotal_before_discount__c ' +
Execute Anonymous:         'FROM ' + ns + 'Sale_Item__c WHERE Id = \'' + line.Id + '\''
Execute Anonymous:     );
Execute Anonymous:     Decimal amount = (Decimal) stored.get(ns + 'Amount__c');
Execute Anonymous:     Decimal priceWithoutTax = (Decimal) stored.get(ns + 'Price_Without_Tax__c');
Execute Anonymous:     Decimal subtotal = (Decimal) stored.get(ns + 'Subtotal_before_discount__c');
Execute Anonymous:     Boolean pass = (amount == 100) && (priceWithoutTax == 100) && (subtotal == 120);
Execute Anonymous: 
Execute Anonymous:     System.debug(LoggingLevel.INFO, '======================================================');
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  SCENARIO C - Shopify bypassed WITH discount, no tax');
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  Subtotal_before_discount__c = ' + subtotal + ' (want 120, the gross)');
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  Price_Without_Tax__c = ' + priceWithoutTax + ' (want 100, net of discount)');
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  Amount__c = ' + amount + ' (want 100, net of discount)');
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  RESULT: ' + (pass ? 'PASS' : 'FAIL (discount ignored)'));
Execute Anonymous:     System.debug(LoggingLevel.INFO, '======================================================');
Execute Anonymous: } catch (Exception e) {
Execute Anonymous:     System.debug(LoggingLevel.ERROR, 'SETUP ERROR: ' + e.getTypeName() + ': ' + e.getMessage() + ' (line ' + e.getLineNumber() + ')');
Execute Anonymous: } finally {
Execute Anonymous:     Database.rollback(sp);
Execute Anonymous: }

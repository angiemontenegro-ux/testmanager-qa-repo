67.0 APEX_CODE,DEBUG;APEX_PROFILING,INFO
Execute Anonymous: /*
Execute Anonymous:  * SH-1169 / PR #2569 — Scenario B: NON-Shopify bypassed write must be LEFT UNTOUCHED.
Execute Anonymous:  * Run standalone (own transaction / own SOQL budget).
Execute Anonymous:  *
Execute Anonymous:  *     sf apex run -o <ORG_ALIAS> -f scripts/apex/validateShopifySaleItemAmountSH1169-B-nonShopifyScope.apex
Execute Anonymous:  *
Execute Anonymous:  * What this proves: the recompute hook is scoped to Source__c = 'Shopify'. A bypassed write from any
Execute Anonymous:  * other source (e.g. POS Mobile) must not be touched by onBypassedBeforeWrite() — this is the guardrail
Execute Anonymous:  * that keeps the fix from leaking into unrelated bypassed writes on other objects/sources.
Execute Anonymous:  *
Execute Anonymous:  * Expected on both old and new code: Amount stays at 40 (PASS either way) — this scenario exists to
Execute Anonymous:  * catch a REGRESSION (someone widening the scope), not to prove the fix itself.
Execute Anonymous:  * All DML is rolled back at the end — the org is left exactly as it was found.
Execute Anonymous:  */
Execute Anonymous: 
Execute Anonymous: final String ns = Schema.getGlobalDescribe().containsKey('Auctifera__CatalogItem__c') ? 'Auctifera__' : '';
Execute Anonymous: final Schema.SObjectType ciType = Schema.getGlobalDescribe().get(ns + 'CatalogItem__c');
Execute Anonymous: final Schema.SObjectType cpType = Schema.getGlobalDescribe().get(ns + 'ClientPurchase__c');
Execute Anonymous: final Schema.SObjectType siType = Schema.getGlobalDescribe().get(ns + 'Sale_Item__c');
Execute Anonymous: 
Execute Anonymous: System.Savepoint sp = Database.setSavepoint();
Execute Anonymous: try {
Execute Anonymous:     SObject item = ciType.newSObject();
Execute Anonymous:     item.put('Name', 'SH-1169 Validation Item B');
Execute Anonymous:     item.put(ns + 'Price__c', 10);
Execute Anonymous:     item.put(ns + 'Tax__c', 0);
Execute Anonymous:     item.put(ns + 'Tax_Model__c', 'Tax not included in the price');
Execute Anonymous:     item.put(ns + 'Product_ID__c', 'SH1169-B-' + String.valueOf(Datetime.now().getTime()));
Execute Anonymous:     item.put(ns + 'Bypass_Stock__c', true);
Execute Anonymous:     insert item;
Execute Anonymous: 
Execute Anonymous:     SObject purchase = cpType.newSObject();
Execute Anonymous:     insert purchase;
Execute Anonymous: 
Execute Anonymous:     SObject line = siType.newSObject();
Execute Anonymous:     line.put(ns + 'Catalog_Item__c', item.Id);
Execute Anonymous:     line.put(ns + 'Client_Purchase__c', purchase.Id);
Execute Anonymous:     line.put(ns + 'Number_of_Items_bought__c', 2);
Execute Anonymous:     insert line;
Execute Anonymous: 
Execute Anonymous:     line.put(ns + 'Item_Price__c', 40);
Execute Anonymous:     line.put(ns + 'Number_of_Items_bought__c', 3);
Execute Anonymous:     line.put(ns + 'Amount__c', 40); // stays wrong on purpose: no Shopify => hook must not touch it
Execute Anonymous:     line.put(ns + 'Price_Without_Tax__c', 40);
Execute Anonymous:     line.put(ns + 'Source__c', 'POS Mobile');
Execute Anonymous:     line.put(ns + 'Technical_Bypass_Triggers__c', true);
Execute Anonymous:     update line;
Execute Anonymous: 
Execute Anonymous:     SObject stored = Database.query(
Execute Anonymous:         'SELECT ' + ns + 'Amount__c FROM ' + ns + 'Sale_Item__c WHERE Id = \'' + line.Id + '\''
Execute Anonymous:     );
Execute Anonymous:     Decimal amount = (Decimal) stored.get(ns + 'Amount__c');
Execute Anonymous:     Boolean pass = (amount == 40);
Execute Anonymous: 
Execute Anonymous:     System.debug(LoggingLevel.INFO, '======================================================');
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  SCENARIO B - Non-Shopify bypassed write (scope guard)');
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  Amount__c = ' + amount + ' (want 40, untouched)');
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  RESULT: ' + (pass ? 'PASS' : 'FAIL (scope leaked into non-Shopify sources)'));
Execute Anonymous:     System.debug(LoggingLevel.INFO, '======================================================');
Execute Anonymous: } catch (Exception e) {
Execute Anonymous:     System.debug(LoggingLevel.ERROR, 'SETUP ERROR: ' + e.getTypeName() + ': ' + e.getMessage() + ' (line ' + e.getLineNumber() + ')');
Execute Anonymous: } finally {
Execute Anonymous:     Database.rollback(sp);
Execute Anonymous: }

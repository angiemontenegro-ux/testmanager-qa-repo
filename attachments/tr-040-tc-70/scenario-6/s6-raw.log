67.0 APEX_CODE,DEBUG;APEX_PROFILING,INFO
Execute Anonymous: // SH-1174 / TC-70 escenario idx 6 (AC-6): TODO tipo de gasto del modulo de gastos (flete, impuesto,
Execute Anonymous: // manejo, aduana, seguro) entra al costo landed sin excepcion. Ningun test del dev combina 3+ tipos
Execute Anonymous: // de gasto concurrentes, asi que QA lo cubre aqui.
Execute Anonymous: //
Execute Anonymous: // PO con CINCO lineas de gasto: 10 + 20 + 30 + 15 + 25 = $100 total.
Execute Anonymous: // Una linea de 10 u @ $10.00 -> efectivo = 10 + 100/10 = $20.00/u. Promedio esperado $20.00.
Execute Anonymous: // Si algun tipo quedara excluido, el efectivo saldria por debajo de $20.00.
Execute Anonymous: 
Execute Anonymous: String tag = 'QA-1174-S6-' + String.valueOf(Datetime.now().getTime());
Execute Anonymous: 
Execute Anonymous: List<Auctifera__POS_Settings__c> settings = [SELECT Id FROM Auctifera__POS_Settings__c LIMIT 1];
Execute Anonymous: if (settings.isEmpty()) {
Execute Anonymous:     insert new Auctifera__POS_Settings__c(Auctifera__Use_Weighted_Cost_Item_Calculation__c = true);
Execute Anonymous: }
Execute Anonymous: 
Execute Anonymous: Auctifera__CatalogItem__c shopItem = new Auctifera__CatalogItem__c(
Execute Anonymous:     Name = tag + ' Item', Auctifera__Product_ID__c = tag, Auctifera__Price__c = 50);
Execute Anonymous: insert shopItem;
Execute Anonymous: 
Execute Anonymous: Auctifera__Purchase_Order__c po = new Auctifera__Purchase_Order__c(Name = tag + ' PO');
Execute Anonymous: insert po;
Execute Anonymous: 
Execute Anonymous: // Los 5 tipos de gasto del ticket, como lineas SEPARADAS del modulo de gastos.
Execute Anonymous: List<Auctifera__Purchase_Order_Expense__c> expenses = new List<Auctifera__Purchase_Order_Expense__c>{
Execute Anonymous:     new Auctifera__Purchase_Order_Expense__c(Name = 'Freight',   Auctifera__Purchase_Order__c = po.Id, Auctifera__Calculation_Type__c = 'Amount', Auctifera__Amount__c = 10),
Execute Anonymous:     new Auctifera__Purchase_Order_Expense__c(Name = 'Tax',       Auctifera__Purchase_Order__c = po.Id, Auctifera__Calculation_Type__c = 'Amount', Auctifera__Amount__c = 20),
Execute Anonymous:     new Auctifera__Purchase_Order_Expense__c(Name = 'Handling',  Auctifera__Purchase_Order__c = po.Id, Auctifera__Calculation_Type__c = 'Amount', Auctifera__Amount__c = 30),
Execute Anonymous:     new Auctifera__Purchase_Order_Expense__c(Name = 'Duties',    Auctifera__Purchase_Order__c = po.Id, Auctifera__Calculation_Type__c = 'Amount', Auctifera__Amount__c = 15),
Execute Anonymous:     new Auctifera__Purchase_Order_Expense__c(Name = 'Insurance', Auctifera__Purchase_Order__c = po.Id, Auctifera__Calculation_Type__c = 'Amount', Auctifera__Amount__c = 25)
Execute Anonymous: };
Execute Anonymous: insert expenses;
Execute Anonymous: 
Execute Anonymous: Auctifera__Purchase_Order__c poCheck = [SELECT Auctifera__Total_Expenses__c FROM Auctifera__Purchase_Order__c WHERE Id = :po.Id];
Execute Anonymous: System.debug('=== SH-1174 S6 :: GASTOS EN LA PO ===');
Execute Anonymous: System.debug('5 lineas de gasto (Freight 10, Tax 20, Handling 30, Duties 15, Insurance 25)');
Execute Anonymous: System.debug('Total_Expenses__c = ' + poCheck.Auctifera__Total_Expenses__c + ' (esperado 100.00 — ningun tipo excluido del rollup)');
Execute Anonymous: 
Execute Anonymous: Auctifera__StockReplenishmentOrder__c line = new Auctifera__StockReplenishmentOrder__c(
Execute Anonymous:     Auctifera__Catalog_Item__c = shopItem.Id, Auctifera__Purchase_Order__c = po.Id,
Execute Anonymous:     Auctifera__Order_Amount__c = 10, Auctifera__Order_Date__c = Date.newInstance(2026, 1, 1),
Execute Anonymous:     Auctifera__Order_Status__c = 'Draft', Auctifera__Item_Cost__c = 10);
Execute Anonymous: insert line;
Execute Anonymous: line.Auctifera__Order_Status__c = 'Received - Complete';
Execute Anonymous: update line;
Execute Anonymous: 
Execute Anonymous: Auctifera__CatalogItem__c after = [SELECT Auctifera__Current_Item_Cost__c, Auctifera__Total_Stock__c FROM Auctifera__CatalogItem__c WHERE Id = :shopItem.Id];
Execute Anonymous: List<Auctifera__Item_Cost_History__c> ichs = [
Execute Anonymous:     SELECT Auctifera__Cost__c, Auctifera__Unit_Cost__c, Auctifera__Allocated_Expense__c, Auctifera__Effective_Cost__c
Execute Anonymous:     FROM Auctifera__Item_Cost_History__c WHERE Auctifera__Shop_Item__c = :shopItem.Id];
Execute Anonymous: 
Execute Anonymous: System.debug('=== SH-1174 S6 :: DESPUES DE RECIBIR ===');
Execute Anonymous: System.debug('Current_Item_Cost__c = ' + after.Auctifera__Current_Item_Cost__c + ' (esperado 20.00 = 10 + 100/10)');
Execute Anonymous: System.debug('Total_Stock__c       = ' + after.Auctifera__Total_Stock__c + ' (esperado 10)');
Execute Anonymous: for (Auctifera__Item_Cost_History__c ich : ichs) {
Execute Anonymous:     System.debug('ICH cost=' + ich.Auctifera__Cost__c + ' unitCost=' + ich.Auctifera__Unit_Cost__c +
Execute Anonymous:         ' allocExpense=' + ich.Auctifera__Allocated_Expense__c + ' (esperado 100.00) effectiveCost=' + ich.Auctifera__Effective_Cost__c);
Execute Anonymous: }
Execute Anonymous: Boolean pass = after.Auctifera__Current_Item_Cost__c == 20.00 && !ichs.isEmpty() && ichs[0].Auctifera__Allocated_Expense__c == 100;
Execute Anonymous: System.debug('=== VEREDICTO S6: ' + (pass ? 'PASS' : 'FAIL') + ' — los 5 tipos de gasto entran al costo landed ===');
Execute Anonymous: System.debug('Shop Item Id: ' + shopItem.Id);

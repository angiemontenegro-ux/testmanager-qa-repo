67.0 APEX_CODE,DEBUG;APEX_PROFILING,INFO
Execute Anonymous: // SH-1174 / TC-70 escenario idx 2 (AC-3): una recepcion posterior promedia el nuevo costo landed
Execute Anonymous: // contra el promedio existente. Cubre la brecha de los tests del dev: los 10 tests funcionales
Execute Anonymous: // insertan UNA sola Purchase Order, asi que nunca mezclan DOS costos efectivos distintos.
Execute Anonymous: //
Execute Anonymous: // PO-1: 10 u @ $10.00 + $20.00 de gasto -> efectivo $12.00/u -> promedio $12.00
Execute Anonymous: // PO-2: 10 u @ $6.00  + $40.00 de gasto -> efectivo $10.00/u
Execute Anonymous: // Promedio esperado = ((10 x 12.00) + (10 x 10.00)) / 20 = $11.00
Execute Anonymous: 
Execute Anonymous: String tag = 'QA-1174-S2-' + String.valueOf(Datetime.now().getTime());
Execute Anonymous: 
Execute Anonymous: // El pipeline de promedio ponderado esta detras de este custom setting.
Execute Anonymous: List<Auctifera__POS_Settings__c> settings = [SELECT Id, Auctifera__Use_Weighted_Cost_Item_Calculation__c FROM Auctifera__POS_Settings__c LIMIT 1];
Execute Anonymous: if (settings.isEmpty()) {
Execute Anonymous:     insert new Auctifera__POS_Settings__c(Auctifera__Use_Weighted_Cost_Item_Calculation__c = true);
Execute Anonymous: } else if (settings[0].Auctifera__Use_Weighted_Cost_Item_Calculation__c != true) {
Execute Anonymous:     settings[0].Auctifera__Use_Weighted_Cost_Item_Calculation__c = true;
Execute Anonymous:     update settings[0];
Execute Anonymous: }
Execute Anonymous: 
Execute Anonymous: Auctifera__CatalogItem__c shopItem = new Auctifera__CatalogItem__c(
Execute Anonymous:     Name = tag + ' Tote',
Execute Anonymous:     Auctifera__Product_ID__c = tag,
Execute Anonymous:     Auctifera__Price__c = 30
Execute Anonymous: );
Execute Anonymous: insert shopItem;
Execute Anonymous: 
Execute Anonymous: // ---------- PRIMERA PURCHASE ORDER ----------
Execute Anonymous: Auctifera__Purchase_Order__c po1 = new Auctifera__Purchase_Order__c(Name = tag + ' PO-1');
Execute Anonymous: insert po1;
Execute Anonymous: insert new Auctifera__Purchase_Order_Expense__c(
Execute Anonymous:     Name = 'Freight PO-1',
Execute Anonymous:     Auctifera__Purchase_Order__c = po1.Id,
Execute Anonymous:     Auctifera__Calculation_Type__c = 'Amount',
Execute Anonymous:     Auctifera__Amount__c = 20
Execute Anonymous: );
Execute Anonymous: Auctifera__StockReplenishmentOrder__c line1 = new Auctifera__StockReplenishmentOrder__c(
Execute Anonymous:     Auctifera__Catalog_Item__c = shopItem.Id,
Execute Anonymous:     Auctifera__Purchase_Order__c = po1.Id,
Execute Anonymous:     Auctifera__Order_Amount__c = 10,
Execute Anonymous:     Auctifera__Order_Date__c = Date.newInstance(2026, 1, 1),
Execute Anonymous:     Auctifera__Order_Status__c = 'Draft',
Execute Anonymous:     Auctifera__Item_Cost__c = 10
Execute Anonymous: );
Execute Anonymous: insert line1;
Execute Anonymous: line1.Auctifera__Order_Status__c = 'Received - Complete';
Execute Anonymous: update line1;
Execute Anonymous: 
Execute Anonymous: Auctifera__CatalogItem__c afterFirst = [SELECT Auctifera__Current_Item_Cost__c, Auctifera__Total_Stock__c FROM Auctifera__CatalogItem__c WHERE Id = :shopItem.Id];
Execute Anonymous: System.debug('=== SH-1174 S2 :: DESPUES DE PO-1 ===');
Execute Anonymous: System.debug('Current_Item_Cost__c = ' + afterFirst.Auctifera__Current_Item_Cost__c + ' (esperado 12.00)');
Execute Anonymous: System.debug('Total_Stock__c       = ' + afterFirst.Auctifera__Total_Stock__c + ' (esperado 10)');
Execute Anonymous: 
Execute Anonymous: // ---------- SEGUNDA PURCHASE ORDER, INDEPENDIENTE, OTRO COSTO EFECTIVO ----------
Execute Anonymous: Auctifera__Purchase_Order__c po2 = new Auctifera__Purchase_Order__c(Name = tag + ' PO-2');
Execute Anonymous: insert po2;
Execute Anonymous: insert new Auctifera__Purchase_Order_Expense__c(
Execute Anonymous:     Name = 'Freight PO-2',
Execute Anonymous:     Auctifera__Purchase_Order__c = po2.Id,
Execute Anonymous:     Auctifera__Calculation_Type__c = 'Amount',
Execute Anonymous:     Auctifera__Amount__c = 40
Execute Anonymous: );
Execute Anonymous: Auctifera__StockReplenishmentOrder__c line2 = new Auctifera__StockReplenishmentOrder__c(
Execute Anonymous:     Auctifera__Catalog_Item__c = shopItem.Id,
Execute Anonymous:     Auctifera__Purchase_Order__c = po2.Id,
Execute Anonymous:     Auctifera__Order_Amount__c = 10,
Execute Anonymous:     Auctifera__Order_Date__c = Date.newInstance(2026, 2, 1),
Execute Anonymous:     Auctifera__Order_Status__c = 'Draft',
Execute Anonymous:     Auctifera__Item_Cost__c = 6
Execute Anonymous: );
Execute Anonymous: insert line2;
Execute Anonymous: line2.Auctifera__Order_Status__c = 'Received - Complete';
Execute Anonymous: update line2;
Execute Anonymous: 
Execute Anonymous: Auctifera__CatalogItem__c afterSecond = [SELECT Auctifera__Current_Item_Cost__c, Auctifera__Total_Stock__c FROM Auctifera__CatalogItem__c WHERE Id = :shopItem.Id];
Execute Anonymous: 
Execute Anonymous: List<Auctifera__Item_Cost_History__c> ichs = [
Execute Anonymous:     SELECT Auctifera__Effective_At__c, Auctifera__Previous_Cost__c, Auctifera__Cost__c,
Execute Anonymous:            Auctifera__Previous_Stock__c, Auctifera__Stock__c,
Execute Anonymous:            Auctifera__Unit_Cost__c, Auctifera__Allocated_Expense__c, Auctifera__Effective_Cost__c,
Execute Anonymous:            Auctifera__Stock_Replenishment_Order__r.Auctifera__Purchase_Order__r.Name
Execute Anonymous:     FROM Auctifera__Item_Cost_History__c
Execute Anonymous:     WHERE Auctifera__Shop_Item__c = :shopItem.Id
Execute Anonymous:     ORDER BY Auctifera__Effective_At__c ASC, CreatedDate ASC
Execute Anonymous: ];
Execute Anonymous: 
Execute Anonymous: System.debug('=== SH-1174 S2 :: DESPUES DE PO-2 ===');
Execute Anonymous: System.debug('Current_Item_Cost__c = ' + afterSecond.Auctifera__Current_Item_Cost__c + ' (esperado 11.00)');
Execute Anonymous: System.debug('Total_Stock__c       = ' + afterSecond.Auctifera__Total_Stock__c + ' (esperado 20)');
Execute Anonymous: System.debug('=== CADENA DE ITEM COST HISTORY (' + ichs.size() + ' registros) ===');
Execute Anonymous: for (Auctifera__Item_Cost_History__c ich : ichs) {
Execute Anonymous:     System.debug(
Execute Anonymous:         'PO=' + ich.Auctifera__Stock_Replenishment_Order__r.Auctifera__Purchase_Order__r.Name +
Execute Anonymous:         ' | prevCost=' + ich.Auctifera__Previous_Cost__c +
Execute Anonymous:         ' | cost=' + ich.Auctifera__Cost__c +
Execute Anonymous:         ' | prevStock=' + ich.Auctifera__Previous_Stock__c +
Execute Anonymous:         ' | stock=' + ich.Auctifera__Stock__c +
Execute Anonymous:         ' | unitCost=' + ich.Auctifera__Unit_Cost__c +
Execute Anonymous:         ' | allocExpense=' + ich.Auctifera__Allocated_Expense__c +
Execute Anonymous:         ' | effectiveCost=' + ich.Auctifera__Effective_Cost__c
Execute Anonymous:     );
Execute Anonymous: }
Execute Anonymous: 
Execute Anonymous: Boolean pass = afterSecond.Auctifera__Current_Item_Cost__c == 11.00 && afterSecond.Auctifera__Total_Stock__c == 20;
Execute Anonymous: System.debug('=== VEREDICTO S2: ' + (pass ? 'PASS' : 'FAIL') + ' ===');
Execute Anonymous: System.debug('Shop Item Id (para inspeccion en Lightning): ' + shopItem.Id);

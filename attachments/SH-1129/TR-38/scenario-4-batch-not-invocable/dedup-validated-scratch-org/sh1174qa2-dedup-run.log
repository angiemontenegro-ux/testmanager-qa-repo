Execute Anonymous: /*
Execute Anonymous:  * SH-1142 / TC-69 escenario 4 - "InventoryHistoryBatch does not create a duplicate same-day
Execute Anonymous:  * snapshot for a history row orphaned by an earlier IPL delete".
Execute Anonymous:  *
Execute Anonymous:  *     sf apex run -o <SCRATCH_ORG> -f scripts/apex/validateInventoryHistoryDedupSH1142.apex
Execute Anonymous:  *
Execute Anonymous:  * DONDE CORRERLO: SOLO en un org con el CODIGO FUENTE del paquete desplegado (scratch org u org
Execute Anonymous:  * de desarrollo del paquete). NO funciona en UAT ni en produccion: alli InventoryHistoryBatch
Execute Anonymous:  * esta declarada public y no global, asi que el paquete gestionado no la expone y cualquier
Execute Anonymous:  * intento de invocarla falla al compilar con "Type is not visible".
Execute Anonymous:  *
Execute Anonymous:  * QUE PRUEBA: tras SH-1129 el lookup Item_per_location__c quedo nullable, asi que al borrar un IPL
Execute Anonymous:  * su fila de historial sobrevive huerfana. SH-1142 cambio la dedup key del batch de
Execute Anonymous:  * Item_per_location__c a la clave de negocio (Shop_Item__c + Item_Variant__c + Location__c) para
Execute Anonymous:  * que esa fila huerfana siga contando como "ya existe hoy". Sin ese cambio, un IPL nuevo para la
Execute Anonymous:  * misma combinacion genera un SEGUNDO snapshot del mismo dia y los reportes de valor de inventario
Execute Anonymous:  * cuentan doble.
Execute Anonymous:  *
Execute Anonymous:  * Antes del fix de SH-1142: quedan 2 filas para hoy (FAIL). Despues: queda 1 (PASS).
Execute Anonymous:  *
Execute Anonymous:  * COMO se ejecuta el batch: se llama execute() directamente con un scope de un solo IPL, en vez de
Execute Anonymous:  * Database.executeBatch. Es sincrono, asi que el resultado se puede asertar en la misma
Execute Anonymous:  * transaccion, y ejercita exactamente onlyNewRecords(), que es donde vive la dedup key.
Execute Anonymous:  *
Execute Anonymous:  * Todo el DML se revierte al final - el org queda como estaba.
Execute Anonymous:  */
Execute Anonymous: 
Execute Anonymous: final String ns = Schema.getGlobalDescribe().containsKey('Auctifera__CatalogItem__c') ? 'Auctifera__' : '';
Execute Anonymous: 
Execute Anonymous: System.Savepoint sp = Database.setSavepoint();
Execute Anonymous: try {
Execute Anonymous:     List<SObject> stores = Database.query(
Execute Anonymous:         'SELECT Id FROM ' + ns + 'Display_Storage_Location__c WHERE ' + ns + 'Type__c = \'Store\' LIMIT 1'
Execute Anonymous:     );
Execute Anonymous:     if (stores.isEmpty()) {
Execute Anonymous:         throw new IllegalArgumentException('No hay Display_Storage_Location__c de tipo Store en este org.');
Execute Anonymous:     }
Execute Anonymous:     Id locId = stores[0].Id;
Execute Anonymous: 
Execute Anonymous:     SObject item = Schema.getGlobalDescribe().get(ns + 'CatalogItem__c').newSObject();
Execute Anonymous:     item.put('Name', 'SH-1142 Dedup Item');
Execute Anonymous:     item.put(ns + 'Price__c', 25);
Execute Anonymous:     item.put(ns + 'Product_ID__c', 'SH1142-' + String.valueOf(Datetime.now().getTime()));
Execute Anonymous:     item.put(ns + 'Bypass_Stock__c', true);
Execute Anonymous:     insert item;
Execute Anonymous: 
Execute Anonymous:     // IPL original, el que despues se borra.
Execute Anonymous:     SObject iplOld = Schema.getGlobalDescribe().get(ns + 'Item_per_location__c').newSObject();
Execute Anonymous:     iplOld.put(ns + 'Shop_Item__c', item.Id);
Execute Anonymous:     iplOld.put(ns + 'Display_Storage_Location__c', locId);
Execute Anonymous:     insert iplOld;
Execute Anonymous: 
Execute Anonymous:     // Snapshot de HOY atado a ese IPL.
Execute Anonymous:     SObject history = Schema.getGlobalDescribe().get(ns + 'Inventory_History__c').newSObject();
Execute Anonymous:     history.put(ns + 'Shop_Item__c', item.Id);
Execute Anonymous:     history.put(ns + 'Location__c', locId);
Execute Anonymous:     history.put(ns + 'Item_per_location__c', iplOld.Id);
Execute Anonymous:     history.put(ns + 'Date__c', Date.today());
Execute Anonymous:     history.put(ns + 'Total_Stock__c', 4);
Execute Anonymous:     history.put(ns + 'Item_Cost__c', 25);
Execute Anonymous:     insert history;
Execute Anonymous: 
Execute Anonymous:     // Se borra el IPL: por SH-1129 la fila de historial sobrevive con el lookup en null (huerfana).
Execute Anonymous:     delete iplOld;
Execute Anonymous: 
Execute Anonymous:     Integer afterDelete = Database.countQuery(
Execute Anonymous:         'SELECT COUNT() FROM ' + ns + 'Inventory_History__c WHERE ' + ns + 'Shop_Item__c = \'' + item.Id + '\''
Execute Anonymous:     );
Execute Anonymous:     Integer orphans = Database.countQuery(
Execute Anonymous:         'SELECT COUNT() FROM ' + ns + 'Inventory_History__c WHERE ' + ns + 'Shop_Item__c = \'' + item.Id +
Execute Anonymous:         '\' AND ' + ns + 'Item_per_location__c = NULL'
Execute Anonymous:     );
Execute Anonymous: 
Execute Anonymous:     // IPL NUEVO para la MISMA combinacion Shop Item + Variant + Location.
Execute Anonymous:     SObject iplNew = Schema.getGlobalDescribe().get(ns + 'Item_per_location__c').newSObject();
Execute Anonymous:     iplNew.put(ns + 'Shop_Item__c', item.Id);
Execute Anonymous:     iplNew.put(ns + 'Display_Storage_Location__c', locId);
Execute Anonymous:     insert iplNew;
Execute Anonymous: 
Execute Anonymous:     // Se re-consulta con los mismos campos que selecciona start(), porque execute() los usa.
Execute Anonymous:     List<Auctifera__Item_per_location__c> scope = Database.query(
Execute Anonymous:         'SELECT Id, ' + ns + 'Item_Variant__c, ' + ns + 'Shop_Item__c, ' + ns + 'Display_Storage_Location__c, ' +
Execute Anonymous:         ns + 'Total_stock_per_location__c, ' + ns + 'Shop_Item__r.Name, ' +
Execute Anonymous:         ns + 'Shop_Item__r.' + ns + 'Item_Cost__c, ' + ns + 'Shop_Item__r.' + ns + 'Current_Item_Cost__c ' +
Execute Anonymous:         'FROM ' + ns + 'Item_per_location__c WHERE Id = \'' + iplNew.Id + '\''
Execute Anonymous:     );
Execute Anonymous: 
Execute Anonymous:     // Se llama execute() directo: sincrono y es donde vive onlyNewRecords().
Execute Anonymous:     new Auctifera.InventoryHistoryBatch().execute(null, scope);
Execute Anonymous: 
Execute Anonymous:     Integer afterBatch = Database.countQuery(
Execute Anonymous:         'SELECT COUNT() FROM ' + ns + 'Inventory_History__c WHERE ' + ns + 'Shop_Item__c = \'' + item.Id + '\''
Execute Anonymous:     );
Execute Anonymous:     Integer todayRows = Database.countQuery(
Execute Anonymous:         'SELECT COUNT() FROM ' + ns + 'Inventory_History__c WHERE ' + ns + 'Shop_Item__c = \'' + item.Id +
Execute Anonymous:         '\' AND ' + ns + 'Date__c = TODAY'
Execute Anonymous:     );
Execute Anonymous: 
Execute Anonymous:     Boolean pass = (todayRows == 1) && (afterBatch == 1);
Execute Anonymous: 
Execute Anonymous:     System.debug(LoggingLevel.INFO, '======================================================');
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  SH-1142 / TC-69 esc. 4 - dedup del batch tras IPL huerfano');
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  filas tras borrar el IPL      = ' + afterDelete + ' (want 1, sobrevive)');
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  de esas, huerfanas            = ' + orphans + ' (want 1, lookup en null)');
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  filas tras correr el batch    = ' + afterBatch + ' (want 1, NO duplico)');
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  filas con fecha de HOY        = ' + todayRows + ' (want 1)');
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  RESULT: ' + (pass ? 'PASS' : 'FAIL'));
Execute Anonymous:     if (!pass) {
Execute Anonymous:         System.debug(LoggingLevel.INFO, '  -> 2 filas de hoy significa que la dedup key sigue siendo Item_per_location__c');
Execute Anonymous:     }
Execute Anonymous:     System.debug(LoggingLevel.INFO, '======================================================');
Execute Anonymous: } catch (Exception e) {
Execute Anonymous:     System.debug(LoggingLevel.ERROR, 'SETUP ERROR: ' + e.getTypeName() + ': ' + e.getMessage() + ' (line ' + e.getLineNumber() + ')');
Execute Anonymous: } finally {
Execute Anonymous:     Database.rollback(sp);
Execute Anonymous: }

Execute Anonymous: /*
Execute Anonymous:  * SH-1142 / TC-69 escenario 4 - re-validacion funcional en org vivo (2026-09-08).
Execute Anonymous:  *
Execute Anonymous:  *     sf apex run -o <SCRATCH_ORG> -f flsrepro-functional-scenario.apex
Execute Anonymous:  *
Execute Anonymous:  * DONDE CORRERLO: SOLO en un org con el CODIGO FUENTE del paquete desplegado (scratch org u org
Execute Anonymous:  * de desarrollo del paquete). NO funciona en UAT ni en produccion: alli InventoryHistoryBatch
Execute Anonymous:  * esta declarada public y no global, asi que el paquete gestionado no la expone y cualquier
Execute Anonymous:  * intento de invocarla falla al compilar con "Type is not visible".
Execute Anonymous:  *
Execute Anonymous:  * POR QUE ESTE SCRIPT EXISTE si ya habia uno: el org de la validacion original (sh1174qa2) expiro.
Execute Anonymous:  * Esta corrida re-valida el mismo escenario en fls-repro y agrega el paso 6, que compara la clave
Execute Anonymous:  * VIEJA contra la NUEVA sobre la MISMA fila huerfana - es decir, demuestra el bug y el fix en la
Execute Anonymous:  * misma corrida, no solo el resultado final.
Execute Anonymous:  *
Execute Anonymous:  * QUE PRUEBA: tras SH-1129 el lookup Item_per_location__c quedo nullable, asi que al borrar un IPL
Execute Anonymous:  * su fila de historial sobrevive huerfana. SH-1142 cambio la dedup key del batch de
Execute Anonymous:  * Item_per_location__c a la clave de negocio (Shop_Item__c + Item_Variant__c + Location__c) para
Execute Anonymous:  * que esa fila huerfana siga contando como "ya existe hoy". Sin ese cambio, un IPL nuevo para la
Execute Anonymous:  * misma combinacion genera un SEGUNDO snapshot del mismo dia y los reportes de valor de inventario
Execute Anonymous:  * cuentan doble.
Execute Anonymous:  *
Execute Anonymous:  * Antes del fix de SH-1142: quedan 2 filas para hoy (FAIL). Despues: queda 1 (PASS).
Execute Anonymous:  *
Execute Anonymous:  * TRAMPA IMPORTANTE PARA QUIEN REUSE ESTO: InventoryHistoryRecorder.hasEnoughInformation() exige un
Execute Anonymous:  * costo, que lee de Shop_Item__r.Item_Cost__c o Item_Variant__r.Cost_per_item__c. Si la query del
Execute Anonymous:  * IPL no trae esos campos de relacion, llegan null, el recorder SALTEA el registro en silencio y el
Execute Anonymous:  * batch inserta 0 filas - se ve como un FAIL y no lo es. La query de abajo calca la de
Execute Anonymous:  * InventoryHistoryBatch.start() a proposito.
Execute Anonymous:  *
Execute Anonymous:  * NO hace rollback: es scratch-only y los registros quedan a proposito para poder tomar capturas.
Execute Anonymous:  * El IPL no se crea a mano: lo genera StockReplenishmentOrder__c en 'Received - Complete'.
Execute Anonymous:  */
Execute Anonymous: 
Execute Anonymous: String tag = 'SH1142-' + Datetime.now().getTime();
Execute Anonymous: Id locationId = DefaultStoreLocation.getId();
Execute Anonymous: 
Execute Anonymous: Auctifera__CatalogItem__c mug = new Auctifera__CatalogItem__c(
Execute Anonymous:     Name = 'Ceramic Mug ' + tag,
Execute Anonymous:     Auctifera__Product_ID__c = tag,
Execute Anonymous:     Auctifera__Price__c = 20,
Execute Anonymous:     Auctifera__Item_Cost__c = 5);
Execute Anonymous: insert mug;
Execute Anonymous: System.debug('STEP 1 - shop item "Ceramic Mug" created, cost 5, price 20');
Execute Anonymous: 
Execute Anonymous: insert new Auctifera__StockReplenishmentOrder__c(
Execute Anonymous:     Name = 'SRO A ' + tag, Auctifera__Order_Amount__c = 10,
Execute Anonymous:     Auctifera__Catalog_Item__c = mug.Id,
Execute Anonymous:     Auctifera__Order_Status__c = 'Received - Complete',
Execute Anonymous:     Auctifera__Item_Cost__c = 5);
Execute Anonymous: 
Execute Anonymous: String iplQuery =
Execute Anonymous:     'SELECT Id, Auctifera__Item_Variant__c, Auctifera__Shop_Item__c,' +
Execute Anonymous:     ' Auctifera__Display_Storage_Location__c, Auctifera__Total_stock_per_location__c,' +
Execute Anonymous:     ' Auctifera__Shop_Item__r.Name, Auctifera__Shop_Item__r.Auctifera__Item_Cost__c,' +
Execute Anonymous:     ' Auctifera__Shop_Item__r.Auctifera__Current_Item_Cost__c,' +
Execute Anonymous:     ' Auctifera__Item_Variant__r.Auctifera__Item_Variant_Name__c,' +
Execute Anonymous:     ' Auctifera__Item_Variant__r.Auctifera__Cost_per_item__c' +
Execute Anonymous:     ' FROM Auctifera__Item_per_location__c WHERE Auctifera__Shop_Item__c = \'' + mug.Id + '\'';
Execute Anonymous: 
Execute Anonymous: List<Auctifera__Item_per_location__c> ipls = Database.query(iplQuery);
Execute Anonymous: System.debug('STEP 2 - stock received 10 units -> IPL rows = ' + ipls.size()
Execute Anonymous:     + ' | stock = ' + (ipls.isEmpty() ? null : ipls[0].Auctifera__Total_stock_per_location__c));
Execute Anonymous: Id firstIplId = ipls.isEmpty() ? null : ipls[0].Id;
Execute Anonymous: 
Execute Anonymous: new InventoryHistoryBatch().execute(null, ipls);
Execute Anonymous: System.debug('STEP 3 - nightly valuation snapshot ran -> rows for TODAY = ' + [
Execute Anonymous:     SELECT COUNT() FROM Auctifera__Inventory_History__c
Execute Anonymous:     WHERE Auctifera__Shop_Item__c = :mug.Id AND Auctifera__Date__c = TODAY]);
Execute Anonymous: 
Execute Anonymous: delete ipls;
Execute Anonymous: List<Auctifera__Inventory_History__c> survivors = [
Execute Anonymous:     SELECT Id, Auctifera__Item_per_location__c, Auctifera__Total_Stock__c
Execute Anonymous:     FROM Auctifera__Inventory_History__c
Execute Anonymous:     WHERE Auctifera__Shop_Item__c = :mug.Id AND Auctifera__Date__c = TODAY];
Execute Anonymous: Integer orphaned = 0;
Execute Anonymous: for (Auctifera__Inventory_History__c h : survivors) {
Execute Anonymous:     if (h.Auctifera__Item_per_location__c == null) { orphaned++; }
Execute Anonymous: }
Execute Anonymous: System.debug('STEP 4 - stock record replaced (IPL deleted) -> snapshot survives = '
Execute Anonymous:     + survivors.size() + ' | of those ORPHANED = ' + orphaned + ' (this is SH-1129 SetNull)');
Execute Anonymous: 
Execute Anonymous: insert new Auctifera__StockReplenishmentOrder__c(
Execute Anonymous:     Name = 'SRO B ' + tag, Auctifera__Order_Amount__c = 10,
Execute Anonymous:     Auctifera__Catalog_Item__c = mug.Id,
Execute Anonymous:     Auctifera__Order_Status__c = 'Received - Complete',
Execute Anonymous:     Auctifera__Item_Cost__c = 5);
Execute Anonymous: List<Auctifera__Item_per_location__c> newIpls = Database.query(iplQuery);
Execute Anonymous: System.debug('STEP 5 - NEW stock record created same day -> IPL rows = ' + newIpls.size()
Execute Anonymous:     + ' | new IPL id differs from old = ' + (newIpls.isEmpty() ? null
Execute Anonymous:         : (Object) (newIpls[0].Id != firstIplId)));
Execute Anonymous: 
Execute Anonymous: Set<Id> newIplIds = new Set<Id>();
Execute Anonymous: for (Auctifera__Item_per_location__c i : newIpls) { newIplIds.add(i.Id); }
Execute Anonymous: Integer oldKeyMatches = [
Execute Anonymous:     SELECT COUNT() FROM Auctifera__Inventory_History__c
Execute Anonymous:     WHERE Auctifera__Date__c = TODAY AND Auctifera__Item_per_location__c IN :newIplIds];
Execute Anonymous: Integer newKeyMatches = [
Execute Anonymous:     SELECT COUNT() FROM Auctifera__Inventory_History__c
Execute Anonymous:     WHERE Auctifera__Date__c = TODAY AND Auctifera__Shop_Item__c = :mug.Id];
Execute Anonymous: System.debug('STEP 6 - dedup lookup, OLD key (by IPL id) finds = ' + oldKeyMatches
Execute Anonymous:     + ' existing rows  -> would insert a SECOND row');
Execute Anonymous: System.debug('STEP 6 - dedup lookup, NEW key (by Shop Item) finds = ' + newKeyMatches
Execute Anonymous:     + ' existing rows  -> recognises the orphan, inserts nothing');
Execute Anonymous: 
Execute Anonymous: new InventoryHistoryBatch().execute(null, newIpls);
Execute Anonymous: List<Auctifera__Inventory_History__c> finalRows = [
Execute Anonymous:     SELECT Id, Auctifera__Item_per_location__c, Auctifera__Total_Stock__c,
Execute Anonymous:            Auctifera__Inventory_Value__c
Execute Anonymous:     FROM Auctifera__Inventory_History__c
Execute Anonymous:     WHERE Auctifera__Shop_Item__c = :mug.Id AND Auctifera__Date__c = TODAY];
Execute Anonymous: System.debug('STEP 7 - snapshot ran again same day -> rows for TODAY = ' + finalRows.size());
Execute Anonymous: for (Auctifera__Inventory_History__c h : finalRows) {
Execute Anonymous:     System.debug('   ROW ' + h.Id + ' | ipl=' + h.Auctifera__Item_per_location__c
Execute Anonymous:         + ' | stock=' + h.Auctifera__Total_Stock__c
Execute Anonymous:         + ' | inventory value=' + h.Auctifera__Inventory_Value__c);
Execute Anonymous: }
Execute Anonymous: 
Execute Anonymous: String verdict;
Execute Anonymous: if (finalRows.size() == 1) {
Execute Anonymous:     verdict = 'PASS - one value for today, the valuation report cannot double-count';
Execute Anonymous: } else if (finalRows.size() == 0) {
Execute Anonymous:     verdict = 'INCONCLUSIVE - no snapshot was ever created, setup problem not a product result';
Execute Anonymous: } else {
Execute Anonymous:     verdict = 'FAIL - ' + finalRows.size() + ' rows for today, report WILL double-count';
Execute Anonymous: }
Execute Anonymous: System.debug('RESULT - ' + verdict);

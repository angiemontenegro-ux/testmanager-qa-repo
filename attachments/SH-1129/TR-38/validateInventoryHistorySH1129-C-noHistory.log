Execute Anonymous: /*
Execute Anonymous:  * SH-1129 / PR #2541 — Scenario C: deleting an Item per location with zero Inventory History
Execute Anonymous:  * completes without error and creates no history rows as a side effect.
Execute Anonymous:  * Guards the removed beforeDelete()/deleteInventoryHistory() path against a null/empty regression.
Execute Anonymous:  * Run standalone (own transaction / own SOQL budget).
Execute Anonymous:  *
Execute Anonymous:  *     sf apex run -o <ORG_ALIAS> -f scripts/apex/validateInventoryHistorySH1129-C-noHistory.apex
Execute Anonymous:  *
Execute Anonymous:  * All DML is rolled back at the end — the org is left exactly as it was found.
Execute Anonymous:  */
Execute Anonymous: 
Execute Anonymous: final String ns = Schema.getGlobalDescribe().containsKey('Auctifera__CatalogItem__c') ? 'Auctifera__' : '';
Execute Anonymous: final Schema.SObjectType ciType = Schema.getGlobalDescribe().get(ns + 'CatalogItem__c');
Execute Anonymous: final Schema.SObjectType iplType = Schema.getGlobalDescribe().get(ns + 'Item_per_location__c');
Execute Anonymous: 
Execute Anonymous: System.Savepoint sp = Database.setSavepoint();
Execute Anonymous: try {
Execute Anonymous:     List<SObject> stores = Database.query(
Execute Anonymous:         'SELECT Id FROM ' + ns + 'Display_Storage_Location__c WHERE ' + ns + 'Type__c = \'Store\' LIMIT 1'
Execute Anonymous:     );
Execute Anonymous:     if (stores.isEmpty()) {
Execute Anonymous:         throw new IllegalArgumentException('No Display_Storage_Location__c of Type__c = Store exists in this org.');
Execute Anonymous:     }
Execute Anonymous:     Id locId = stores[0].Id;
Execute Anonymous: 
Execute Anonymous:     SObject item = ciType.newSObject();
Execute Anonymous:     item.put('Name', 'SH-1129 Validation Item C');
Execute Anonymous:     item.put(ns + 'Price__c', 25);
Execute Anonymous:     item.put(ns + 'Product_ID__c', 'SH1129-C-' + String.valueOf(Datetime.now().getTime()));
Execute Anonymous:     item.put(ns + 'Bypass_Stock__c', true);
Execute Anonymous:     insert item;
Execute Anonymous: 
Execute Anonymous:     SObject ipl = iplType.newSObject();
Execute Anonymous:     ipl.put(ns + 'Shop_Item__c', item.Id);
Execute Anonymous:     ipl.put(ns + 'Display_Storage_Location__c', locId);
Execute Anonymous:     insert ipl;
Execute Anonymous: 
Execute Anonymous:     Integer historyBefore = Database.countQuery(
Execute Anonymous:         'SELECT COUNT() FROM ' + ns + 'Inventory_History__c WHERE ' + ns + 'Shop_Item__c = \'' + item.Id + '\''
Execute Anonymous:     );
Execute Anonymous: 
Execute Anonymous:     Boolean deleteSucceeded = true;
Execute Anonymous:     String failure = '';
Execute Anonymous:     try {
Execute Anonymous:         delete ipl;
Execute Anonymous:     } catch (Exception de) {
Execute Anonymous:         deleteSucceeded = false;
Execute Anonymous:         failure = de.getTypeName() + ': ' + de.getMessage();
Execute Anonymous:     }
Execute Anonymous: 
Execute Anonymous:     Integer historyAfter = Database.countQuery(
Execute Anonymous:         'SELECT COUNT() FROM ' + ns + 'Inventory_History__c WHERE ' + ns + 'Shop_Item__c = \'' + item.Id + '\''
Execute Anonymous:     );
Execute Anonymous: 
Execute Anonymous:     Boolean pass = deleteSucceeded && (historyBefore == 0) && (historyAfter == 0);
Execute Anonymous: 
Execute Anonymous:     System.debug(LoggingLevel.INFO, '======================================================');
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  SCENARIO C - deleting an IPL with no history is a no-op');
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  delete succeeded = ' + deleteSucceeded + ' (want true)' + (failure == '' ? '' : ' | ' + failure));
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  history rows before = ' + historyBefore + ' / after = ' + historyAfter + ' (want 0 / 0)');
Execute Anonymous:     System.debug(LoggingLevel.INFO, '  RESULT: ' + (pass ? 'PASS' : 'FAIL'));
Execute Anonymous:     System.debug(LoggingLevel.INFO, '======================================================');
Execute Anonymous: } catch (Exception e) {
Execute Anonymous:     System.debug(LoggingLevel.ERROR, 'SETUP ERROR: ' + e.getTypeName() + ': ' + e.getMessage() + ' (line ' + e.getLineNumber() + ')');
Execute Anonymous: } finally {
Execute Anonymous:     Database.rollback(sp);
Execute Anonymous: }
